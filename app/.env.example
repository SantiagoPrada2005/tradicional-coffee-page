VITE_META_PIXEL_ID=123456789012345

# -------------------------------------------------------------
# CLOUDFLARE PAGES FUNCTIONS (Server-Side - variables secretas en Cloudflare Dashboard)
# Configurar en Cloudflare Pages > Settings > Environment variables
# -------------------------------------------------------------
META_PIXEL_ID=123456789012345
META_ACCESS_TOKEN=EAAG...TU_TOKEN_DE_SISTEMA_AQUI
# Opcional para pruebas en la pestaña "Probar eventos" de Meta Events Manager
META_TEST_EVENT_CODE=
